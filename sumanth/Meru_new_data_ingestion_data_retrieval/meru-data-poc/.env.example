# Threat Intelligence Data Collector — copy to .env (same folder as main.py)

# --- AlienVault OTX (header: X-OTX-API-KEY) ---
OTX_API_KEY=
OTX_BASE_URL=https://otx.alienvault.com/api/v1
OTX_PULSE_LIMIT=25

# --- Abuse.ch: Auth-Key sent as HTTP header (register at https://auth.abuse.ch/) ---
URLHAUS_API_URL=https://urlhaus-api.abuse.ch/v1/
URLHAUS_AUTH_KEY=
URLHAUS_LIMIT=100

MALWAREBAZAAR_API_URL=https://mb-api.abuse.ch/api/v1/
MALWAREBAZAAR_AUTH_KEY=
MALWAREBAZAAR_SELECTOR=100

THREATFOX_API_URL=https://threatfox-api.abuse.ch/api/v1/
THREATFOX_AUTH_KEY=
THREATFOX_DAYS=7

# --- NJCCIC (no auth; often blocked by Incapsula for non-browser clients) ---
NJCCIC_BASE_URL=https://www.cyber.nj.gov/threat-center/alerts-advisories

# --- Output & HTTP ---
OUTPUT_DIR=output
REQUEST_TIMEOUT=45
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_FACTOR=0.8
HTTP_USER_AGENT=meru-threat-collector/1.0 (research)
LOG_LEVEL=INFO

# --- Optional: MongoDB (collection ti_ingestion in default DB from URI) ---
MONGODB_URI=
