# Environment Configuration for News Aggregator Authentication API
# Copy this file to .env and update the values

# Flask Configuration
SECRET_KEY=news_auth_super_secret_key_2024_dev_mode_12345
FLASK_ENV=development

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=''
DB_NAME=news_auth_db

# JWT Configuration (optional - uses SECRET_KEY if not set)
JWT_SECRET_KEY=jwt_news_auth_secret_key_2024_secure_token

# API Configuration
API_PORT=5000
API_HOST=0.0.0.0