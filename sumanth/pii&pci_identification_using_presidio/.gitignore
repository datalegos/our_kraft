# ========================================
# KEEP THESE DIRECTORIES BUT IGNORE CONTENTS
# ========================================
# Keep directory structure but ignore sensitive contents
data/extracted_data/.gitkeep
data/pci_analysis_results/.gitkeep
logs/.gitkeep

# ========================================
# EXCEPTIONS - Files to ALWAYS include
# ========================================
# Configuration templates (without credentials)
!config/extraction_config.yml
!config/presidio_config.yml

# Requirements files
!requirements/
!requirements/*.txt

# Documentation
!README.md
!*.md

# Scripts (but not data they generate)
!scripts/
!scripts/*.sh
!scripts/*.ps1

# Source code
!src/
!src/*.py

# SQL schema files (structure only, no data)
!sql_scripts/
!sql_scripts/*_schema.sql
# Exclude data files
sql_scripts/*_data.sql