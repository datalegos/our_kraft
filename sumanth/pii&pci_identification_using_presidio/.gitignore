# PCI Data Extraction Project - .gitignore

# ========================================
# SENSITIVE DATA - NEVER COMMIT
# ========================================
# Extracted database data (contains PCI/PII)
data/extracted_data/
data/pci_analysis_results/

# Configuration files with credentials
config/config.env
config/*.env
*.env

# Database connection strings
*.db
*.sqlite
*.sqlite3

# ========================================
# LOGS AND TEMPORARY FILES
# ========================================
# Log files
logs/
*.log
*.log.*

# Temporary files
temp/
tmp/
*.tmp
*.temp

# ========================================
# PYTHON
# ========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
src/__pycache__/
scripts/__pycache__/

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
