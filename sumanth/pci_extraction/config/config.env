# Database Configuration for PCI Data POC

# Database Type (postgresql, mysql)
DB_TYPE=postgresql

# Database 1 - Customer Database
DB1_HOST=localhost
DB1_PORT=5432
DB1_NAME=customer_db
DB1_USER=postgres
DB1_PASSWORD=pgadmin
DB1_ADMIN_USER=postgres
DB1_ADMIN_PASSWORD=pgadmin

# Database 2 - Payment Database  
DB2_HOST=localhost
DB2_PORT=5432
DB2_NAME=payment_db
DB2_USER=postgres
DB2_PASSWORD=pgadmin
DB2_ADMIN_USER=postgres
DB2_ADMIN_PASSWORD=pgadmin

# Script Configuration
SCRIPT_DIR=./sql_scripts
LOG_DIR=./logs

# Execution Options
CREATE_DATABASES=true
DROP_EXISTING=false
TEST_CONNECTIONS=true